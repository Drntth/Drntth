[global_config]
  suppress_multiple_term_dialog = True
[keybindings]
  split_horiz = <Primary><Shift>o
  split_vert = <Primary><Shift>e
[profiles]
  [[default]]
    background_color = "#300a24"
    background_darkness = 0.9
    background_type = transparent
    font = Monospace 12
    foreground_color = "#ffffff"
    scrollback_infinite = True
    title_hide_sizetext = True
  [[ssh]]
    background_darkness = 0.9
    background_type = transparent
    foreground_color = "#00ff00"
    title_hide_sizetext = True
  [[git]]
    background_darkness = 0.9
    background_type = transparent
    foreground_color = "#e53c00"
    title_hide_sizetext = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 1000, 800
      position = 0:0
      is_maximized = False
      title = Terminator
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
  [[own-config]] # own config name
    [[[child0]]]
      type = Window
      parent = ""
      order = 0
      position = 26:23
      maximised = False
      fullscreen = False
      size = 1740, 930
      title = own-config # own config name
      last_active_term = ***
      last_active_window = True
    [[[child1]]]
      type = VPaned
      parent = child0
      order = 0
      position = 456
      ratio = 0.492972972972973
    [[[child2]]]
      type = HPaned
      parent = child1
      order = 0
      position = 442
      ratio = 0.3803786574870912
    [[[terminal3]]]
      type = Terminal
      parent = child2
      order = 0
      profile = ssh
      uuid = *** # own uuid
      command = ssh user@your-server.com # own ssh connection
    [[[child4]]]
      type = HPaned
      parent = child2
      order = 1
      position = 352
      ratio = 0.48956884561891517
    [[[terminal5]]]
      type = Terminal
      parent = child4
      order = 0
      profile = git
      uuid = *** # own uuid
      command = cd /path/to/your/project && git pull && bash # own path to git repository
    [[[terminal6]]]
      type = Terminal
      parent = child4
      order = 1
      profile = git
      uuid = *** # own uuid
      command = cd /path/to/your/project && git status && bash # own path to git repository
    [[[terminal7]]]
      type = Terminal
      parent = child1
      order = 1
      profile = default
      uuid = *** # own uuid
      command = cd /path/to/your/project && bash # own path to project
[plugins]
