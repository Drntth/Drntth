# .gitignore for the development repository

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
*.log

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
pip-log.txt

# Jupyter notebook checkpoints
.ipynb_checkpoints

# VS Code
.vscode/
.history/

# OS/Editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Images, temporary, or generated files (if you don't want to version them)
# /assets/tmp/
# /results/
# /output/

# Node.js (if applicable)
node_modules/
npm-debug.log

# .env and other sensitive data
.env

# Configuration files
config
*.config
*.conf

# Other private or temporary files
*.bak
*.tmp

# Recommended: custom build/temp folders, if any
# build/
# dist/